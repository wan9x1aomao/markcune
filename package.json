  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "dev": "tauri dev",
    "build": "tauri build --bundles app",
    "build:debug": "tauri build --debug --bundles app",
    "build:win": "tauri build --bundles nsis",
    "test": "node tests/tidy.test.mjs && node tests/ai.test.mjs && node tests/gateway.test.mjs && node tests/notices.test.mjs && node tests/changelog.test.mjs",
    "test:browser": "node tests/ai-browser.mjs"
  },
  "devDependencies": {
